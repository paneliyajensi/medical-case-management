{
  "info": {
    "_postman_id": "c1f73b22-83b5-4b07-9e48-medcase-v1",
    "name": "MedCase API - @Jajal Medical",
    "description": "Postman / Thunder Client API collection for MedCase Implant Management System with Sanctum token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "viewerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medcase.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login (Viewer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@medcase.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Cases",
      "item": [
        {
          "name": "List Cases (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases?page=1&status=Planning",
              "host": ["{{baseUrl}}"],
              "path": ["cases"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "status", "value": "Planning" }
              ]
            }
          }
        },
        {
          "name": "Create Case (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-5001\",\n  \"patient_reference\": \"PAT-9912\",\n  \"surgeon_name\": \"Dr. Sarah Jenkins\",\n  \"implant_type\": \"Titanium Hip Stem (Mod-4)\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases",
              "host": ["{{baseUrl}}"],
              "path": ["cases"]
            }
          }
        },
        {
          "name": "Get Single Case",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "1"]
            }
          }
        },
        {
          "name": "Update Case (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-1001\",\n  \"patient_reference\": \"PAT-8812\",\n  \"surgeon_name\": \"Dr. Sarah Jenkins\",\n  \"implant_type\": \"Titanium Hip Stem (Mod-4)\",\n  \"status\": \"Approved\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-10-25\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "1"]
            }
          }
        },
        {
          "name": "Delete Case (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "1"]
            }
          }
        }
      ]
    }
  ]
}
